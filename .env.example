# Firehose WebSocket URL (AT Protocol official endpoint)
FIREHOSE_URL=wss://bsky.network/xrpc/com.atproto.sync.subscribeRepos

# PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/bsky_data?sslmode=disable

# Collection mode: "full" (collect everything) or "moderation-priority" (prioritize moderation data)
COLLECTION_MODE=moderation-priority

# Statistics reporting interval in seconds
STATS_INTERVAL_SEC=30

# Log level (info, debug)
LOG_LEVEL=info