# PostgreSQL connection string
DATABASE_URL=postgres://username:password@localhost:5432/bsky_data?sslmode=disable

# PostgreSQL credentials (used by docker-compose; keep in sync with DATABASE_URL)
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=bsky_data

# Statistics reporting interval in seconds
STATS_INTERVAL_SEC=10
# Stats verbose switches (1=enabled, 0=disabled)
DB_STATS_VERBOSE=0
FIREHOSE_STATS_VERBOSE=1

# Firehose configuration
FIREHOSE_URL=wss://bsky.network/xrpc/com.atproto.sync.subscribeRepos
FIREHOSE_EVENT_CHANNEL_SIZE=10000
FIREHOSE_SCHEDULER_WORKERS=10
FIREHOSE_SCHEDULER_QUEUE=100

# Label aggregator configuration
LABEL_AGGREGATOR_FIREHOSE_URL=wss://bsky.network/xrpc/com.atproto.sync.subscribeRepos
LABEL_AGGREGATOR_CSV_PATH=labelers.csv
LABEL_AGGREGATOR_EVENT_CHANNEL_SIZE=50000
LABEL_AGGREGATOR_MAX_CONCURRENT=300
LABEL_AGGREGATOR_MAX_PER_TICK=50
LABEL_AGGREGATOR_MAX_RESOLVE_FAILURES=3
LABEL_AGGREGATOR_MAX_CONNECT_FAILURES=5

# Per-processor verbose logging (1=enabled, 0=disabled)
POST_PROCESSOR_VERBOSE=0
LIST_PROCESSOR_VERBOSE=0
LABEL_PROCESSOR_VERBOSE=0
BLOCK_PROCESSOR_VERBOSE=0

# Processors batch configuration (Post, Block, List, Label)
PROCESSOR_BATCH_SIZE=10000
PROCESSOR_TICKER_SEC=1

# Per-fetcher verbose logging (1=enabled, 0=disabled)
POST_FETCHER_VERBOSE=0
LIST_FETCHER_VERBOSE=0
ACTOR_FETCHER_VERBOSE=0

# Post fetcher specific
POST_FETCH_MAX_CONCURRENT=5
POST_FETCH_MAX_CONTEXT_DEPTH=10
THREAD_PARENT_HEIGHT=80
THREAD_REPLY_DEPTH=80